@using AssetGuard.Entity
@model List<Asset>

@{
    ViewData["Title"] = "Demirbaş Listesi";
    Layout = "~/Views/Shared/_Layout.cshtml";
    bool isAdmin = User.IsInRole("Admin");
}

<style>
    /* DataTables Oklarını Gizle */
    table.dataTable thead .sorting:before, table.dataTable thead .sorting:after,
    table.dataTable thead .sorting_asc:before, table.dataTable thead .sorting_asc:after,
    table.dataTable thead .sorting_desc:before, table.dataTable thead .sorting_desc:after {
        display: none !important;
    }

    /* Başlıklar */
    #assetTable thead th:not(.static-header) {
        cursor: pointer;
        transition: 0.2s;
        padding: 12px 8px !important;
        text-transform: uppercase;
        font-size: 0.85rem;
    }

        #assetTable thead th:not(.static-header):hover {
            background-color: #f4f6f9 !important;
            color: #007bff;
            text-decoration: underline;
        }

    #assetTable thead th.sorting_asc, #assetTable thead th.sorting_desc {
        color: #007bff;
        border-bottom: 2px solid #007bff !important;
    }

    /* Statik Başlıklar */
    .static-header {
        cursor: default !important;
        pointer-events: none;
        color: #999 !important;
    }

    /* SÖNÜK BUTON STİLİ (User İçin) */
    .disabled-action-btn {
        pointer-events: none !important; /* Tıklamayı engeller */
        opacity: 0.5 !important; /* Soluklaştırır */
        cursor: not-allowed !important; /* Yasak imleci */
        background-color: #6c757d !important; /* Gri Renk */
        border-color: #6c757d !important;
        color: white !important;
        display: inline-block;
        padding: 0.25rem 0.5rem;
        font-size: 0.875rem;
        line-height: 1.5;
        border-radius: 0.2rem;
        text-align: center;
        vertical-align: middle;
        text-decoration: none;
    }
</style>

<div class="card">
    <div class="card-header border-0">
        <h3 class="card-title">Demirbaş Envanter Listesi</h3>
        <div class="card-tools">
            <!-- Excel Butonu: HERKES GÖRÜR -->
            <a href="/Report/ExportToExcel" class="btn btn-success btn-sm mr-2">
                <i class="fas fa-file-excel mr-1"></i> Excel'e Aktar
            </a>

            <!-- Yeni Giriş Butonu: SADECE ADMIN GÖRÜR (Else bloğu yok!) -->
            @if (User.IsInRole("Admin"))
            {
                <a href="/Asset/Create" class="btn btn-primary btn-sm">
                    <i class="fas fa-plus"></i> Yeni Giriş
                </a>
            }
        </div>
    </div>

    <div class="card-body p-0">
        <table id="assetTable" class="table table-striped projects table-hover m-0">
            <thead>
                <tr>
                    <th style="display:none;">ID</th>
                    <th class="static-header" style="width: 8%">Görsel</th>
                    <th>Ürün Adı</th>
                    <th>Kategori</th>
                    <th>Seri No</th>
                    <th style="width: 12%">Fiyat</th>
                    <th class="text-center">Durum</th>
                    <th class="static-header text-right" style="width: 15%">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td style="display:none;">@item.Id</td>
                        <td class="text-center">
                            @{
                                var listImg = string.IsNullOrWhiteSpace(item.ImageUrl) ? "/img/no-image.png" : "/img/assets/" + item.ImageUrl;
                            }
                            <img src="@listImg" style="width: 40px; height: 40px; object-fit: cover; border-radius: 4px;" onerror="this.src='/img/no-image.png';" />
                        </td>
                        <td>
                            <strong>@item.AssetName</strong><br />
                            <small class="text-muted">Alım: @item.PurchaseDate.ToString("dd.MM.yyyy")</small>
                        </td>
                        <td><span class="badge badge-info">@item.Category?.Name</span></td>
                        <td>@item.SerialNo</td>

                        <!-- Saf Sayı -->
                        <td>@item.Price.ToString(System.Globalization.CultureInfo.InvariantCulture)</td>

                        <td class="text-center">
                            @{
                                var status = item.Status?.Name ?? "Bilinmiyor";
                                var badgeColor = status.Contains("Sağlam") || status.Contains("Zimmetli") || status.Contains("Kullanılabilir") ? "success" : "warning";
                                if (status.Contains("Hurda") || status.Contains("Arızalı")) { badgeColor = "danger"; }
                            }
                            <span class="badge badge-@badgeColor">@status</span>
                        </td>

                        <td style="vertical-align: middle;">
                            @if (User.IsInRole("Admin"))
                            {
                                <!-- ADMIN GÖRÜNÜMÜ: Hepsi Var, Ortalanmış Grup -->
                                <div class="btn-group d-flex justify-content-center">
                                    <a href="/Asset/Details/@item.Id" class="btn btn-info btn-sm" title="QR ve Detay">
                                        <i class="fas fa-qrcode"></i> Detay
                                    </a>
                                    <a href="/Asset/Edit/@item.Id" class="btn btn-primary btn-sm" title="Düzenle">
                                        <i class="fas fa-edit"></i> Düzenle
                                    </a>
                                    <a href="/Asset/Delete/@item.Id" class="btn btn-danger btn-sm" title="Sil">
                                        <i class="fas fa-trash"></i> Sil
                                    </a>
                                </div>
                            }
                            else
                            {
                                <!-- USER GÖRÜNÜMÜ: Sadece Detay, Sağa Yaslı -->
                                <div class="float-right">
                                    <a href="/Asset/Details/@item.Id" class="btn btn-info btn-sm" title="QR ve Detay">
                                        <i class="fas fa-qrcode"></i> Detay
                                    </a>
                                </div>
                            }
                        </td>

                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script src="~/plugins/datatables/jquery.dataTables.min.js"></script>
    <script src="~/plugins/datatables-bs4/js/dataTables.bootstrap4.min.js"></script>

    <script>
        $(document).ready(function () {
            if ($.fn.DataTable.isDataTable('#assetTable')) {
                $('#assetTable').DataTable().destroy();
            }

            $("#assetTable").DataTable({
                "responsive": true,
                "lengthChange": true,
                "autoWidth": false,
                "language": { "url": "https://cdn.datatables.net/plug-ins/1.10.25/i18n/Turkish.json" },
                "order": [[5, "desc"]],
                "columnDefs": [
                    { "targets": [0], "visible": false },
                    { "targets": [1, 7], "orderable": false },
                    {
                        "targets": 5,
                        "render": function (data, type, row) {
                            if (type === 'sort' || type === 'type') { return parseFloat(data); }
                            var val = parseFloat(data);
                            return '₺ ' + val.toLocaleString('tr-TR', { minimumFractionDigits: 0 });
                        }
                    }
                ]
            });
        });
    </script>
}