@*Şimdi kullanıcıya görünecek formu tasarlıyoruz. Bunun için baz alınan Templete'in "Card Primary" stilini kullanacağız.*@

@model AssetGuard.WebUI.Models.AssetAddViewModel

@{
    ViewData["Title"] = "Yeni Demirbaş Ekle";
}

<div class="row">
    <div class="col-md-12">
        <div class="card card-primary">
            <div class="card-header">
                <h3 class="card-title">Demirbaş Kayıt Formu</h3>
            </div>
            <!-- /.card-header -->
            <!-- Form Başlangıcı -->
            <form method="post">
                <div class="card-body">

                    <!-- 1. Ürün Adı -->
                    <div class="form-group">
                        <label>Ürün Adı / Marka Model</label>
                        <input type="text" class="form-control" asp-for="Asset.AssetName" placeholder="Örn: Lenovo Thinkpad E14">
                    </div>

                    <!-- 2. Seri No -->
                    <div class="form-group">
                        <label>Seri Numarası</label>
                        <input type="text" class="form-control" asp-for="Asset.SerialNo" placeholder="Cihazın altındaki barkod">
                    </div>

                    <div class="row">
                        <!-- 3. Kategori (DROPDOWN) -->
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Kategori Seçin</label>
                                <!-- Select, Asset içindeki CategoryId'yi dolduracak -->
                                <select class="form-control" asp-for="Asset.CategoryId">
                                    <option value="">-- Seçiniz --</option>
                                    @foreach (var item in Model.CategoryList)
                                    {
                                        <option value="@item.Id">@item.Name</option>
                                    }
                                </select>
                            </div>
                        </div>

                        <!-- 4. Durum (DROPDOWN) -->
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Fiziksel Durumu</label>
                                <select class="form-control" asp-for="Asset.StatusId">
                                    @foreach (var item in Model.StatusList)
                                    {
                                        <option value="@item.Id">@item.Name</option>
                                    }
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <!-- 5. Fiyat -->
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Fiyat (TL)</label>
                                <input type="number" step="0.01" class="form-control" asp-for="Asset.Price">
                            </div>
                        </div>

                        <!-- 6. Satın Alma Tarihi -->
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Satın Alma Tarihi</label>
                                <input type="date" class="form-control" asp-for="Asset.PurchaseDate">
                            </div>
                        </div>
                    </div>

                </div>
                <!-- /.card-body -->

                <div class="card-footer">
                    <button type="submit" class="btn btn-success">Kaydet</button>
                    <a href="/Asset/Index" class="btn btn-secondary">İptal</a>
                </div>
            </form>
        </div>
    </div>
</div>