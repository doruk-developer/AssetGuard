@model AssetGuard.WebUI.Models.AssetAddViewModel
@{
    ViewData["Title"] = "Yeni Demirbaş Ekle";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- LOCAL DROPIFY CSS -->
<link rel="stylesheet" href="~/plugins/dropify/css/dropify.min.css" />

<div class="card card-primary">
    <div class="card-header">
        <h3 class="card-title">Demirbaş Kayıt Formu</h3>
    </div>

    <!-- enctype="multipart/form-data" olmadan resim yüklenemez! -->
    <form asp-action="Create" method="post" enctype="multipart/form-data">
        <div class="card-body">

            <div class="row">
                <!-- SOL SÜTUN: Metinsel Bilgiler -->
                <div class="col-md-6">
                    <div class="form-group">
                        <label>Ürün Adı</label>
                        <input type="text" asp-for="Asset.AssetName" class="form-control" placeholder="Örn: HP Laptop 15-dw3" required />
                    </div>

                    <div class="form-group">
                        <label>Seri Numarası</label>
                        <input type="text" asp-for="Asset.SerialNo" class="form-control" placeholder="Cihaz barkod numarası" required />
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Kategori</label>
                                <select asp-for="Asset.CategoryId" class="form-control" asp-items="@(new SelectList(Model.CategoryList, "Id", "Name"))">
                                    <option value="" disabled selected>Seçiniz</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Fiziksel Durumu</label>
                                <select asp-for="Asset.StatusId" class="form-control" asp-items="@(new SelectList(Model.StatusList, "Id", "Name"))">
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="form-group">
                        <label>Fiyat (TL)</label>
                        <input type="number" step="0.01" asp-for="Asset.Price" class="form-control" placeholder="0.00" />
                    </div>
                </div>

                <!-- SAĞ SÜTUN: Tarihler ve Resim -->
                <div class="col-md-6">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Satın Alma Tarihi</label>
                                <input type="date" asp-for="Asset.PurchaseDate" class="form-control" />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Garanti Bitiş Tarihi</label>
                                <input type="date" asp-for="Asset.WarrantyEndDate" class="form-control" />
                            </div>
                        </div>
                    </div>

                    <!-- SÜRÜKLE BIRAK RESİM ALANI -->
                    <div class="form-group">
                        <label>Ürün Görseli</label>
                        <!-- data-height kutu boyunu ayarlar -->
                        <input type="file" asp-for="Image" class="dropify" data-height="210" accept=".jpg,.jpeg,.png" />
                        <small class="text-muted">
                            <i class="fas fa-mouse-pointer"></i> Resmi buraya sürükleyin veya tıklayarak seçin.
                        </small>
                    </div>
                </div>
            </div>

        </div>

        <div class="card-footer">
            <button type="submit" class="btn btn-success"><i class="fas fa-save"></i> Kaydet</button>
            <a href="/Asset/Index" class="btn btn-secondary">İptal</a>
        </div>
    </form>
</div>

@section Scripts {
    <!-- LOCAL DROPIFY JS -->
    <script src="~/plugins/dropify/js/dropify.min.js"></script>

    <script>
        $(document).ready(function () {
            // Dropify'ı Türkçe ve özel ayarlarla başlat
            $('.dropify').dropify({
                messages: {
                    'default': 'Dosyayı buraya sürükleyin veya tıklayın',
                    'replace': 'Değiştirmek için sürükleyin veya tıklayın',
                    'remove':  'Kaldır',
                    'error':   'Bir hata oluştu.'
                },
                tpl: {
                    message: '<div class="dropify-message"><span class="file-icon" /> <p style="font-size:16px;">{{ default }}</p></div>'
                }
            });
        });
    </script>
}