@using AssetGuard.Entity
@model List<AssetStatus>

@{
    ViewData["Title"] = "Demirbaş Durumları";
}

<div class="card">
    <div class="card-header">
        <h3 class="card-title">Tanımlı Durumlar</h3>
        <div class="card-tools">
            <a href="/AssetStatus/Create" class="btn btn-primary btn-sm">
                <i class="fas fa-plus"></i> Yeni Durum Ekle
            </a>
        </div>
    </div>

    <div class="card-body p-0">
        <table class="table table-striped projects table-hover">
            <thead>
                <tr>
                    <th style="width: 10%">ID</th>
                    <th style="width: 70%">Durum Adı</th>
                    <th style="width: 20%">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Id</td>
                        <td>
                            <!-- DÜZELTİLEN KISIM BURASI -->
                            <!-- Veritabanından gelen rengi kullanır, yoksa 'secondary' (gri) yapar -->
                            <span class="badge badge-@(item.ColorClass ?? "secondary")">@item.Name</span>
                        </td>
                        <td class="project-actions text-right">
                            <a class="btn btn-info btn-sm" href="/AssetStatus/Edit/@item.Id">
                                <i class="fas fa-pencil-alt"></i> Düzenle
                            </a>
                            <a class="btn btn-danger btn-sm" href="/AssetStatus/Delete/@item.Id" onclick="return confirm('Bu durumu silmek istediğinize emin misiniz?');">
                                <i class="fas fa-trash"></i> Sil
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>