@using AssetGuard.Entity
@model AssetGuard.WebUI.Models.EmployeeListViewModel

@{
    ViewData["Title"] = "Personel Listesi";
    Layout = "~/Views/Shared/_Layout.cshtml";

    // Rol Kontrolü
    bool isAdmin = User.IsInRole("Admin");
}

<style>
    /* 1. DataTables Oklarını Gizle */
    table.dataTable thead .sorting:before, table.dataTable thead .sorting:after,
    table.dataTable thead .sorting_asc:before, table.dataTable thead .sorting_asc:after,
    table.dataTable thead .sorting_desc:before, table.dataTable thead .sorting_desc:after {
        display: none !important;
    }

    /* 2. Başlık Stilleri */
    #tblEmployees thead th:not(.static-header) {
        cursor: pointer;
        transition: 0.2s;
        padding: 12px 8px !important;
        text-transform: uppercase;
        font-size: 0.85rem;
    }

        #tblEmployees thead th:not(.static-header):hover {
            background-color: #f4f6f9 !important;
            color: #007bff;
            text-decoration: underline;
        }

    #tblEmployees thead th.sorting_asc, #tblEmployees thead th.sorting_desc {
        color: #007bff;
        border-bottom: 2px solid #007bff !important;
    }

    /* 3. Statik Başlıklar */
    .static-header {
        cursor: default !important;
        pointer-events: none;
        color: #999 !important;
    }
</style>

<div class="card">
    <div class="card-header border-0">
        <h3 class="card-title">Aktif Personel Kayıtları</h3>
        <div class="card-tools">
            @if (isAdmin)
            {
                <a href="/Employee/Create" class="btn btn-primary btn-sm">
                    <i class="fas fa-user-plus mr-1"></i> Yeni Personel
                </a>
            }
        </div>
    </div>

    <div class="card-body p-0">
        <table id="tblEmployees" class="table table-striped projects table-hover m-0" style="width:100% !important;">
            
            <thead>
                <tr>
                    <th style="display:none;">ID</th> <!-- Index 0 -->
                    @if (isAdmin)
                    {
                        // Admin için 4 sütunlu dağılım (Toplam %100)
                        <th style="width: 30%">Ad Soyad</th>
                        <th style="width: 30%">Departman</th>
                        <th style="width: 20%">Durum</th>
                        <th class="static-header text-right" style="width: 20%">İşlemler</th>
                    }
                    else
                    {
                        // User için 3 sütunlu tam yayılım (Toplam %100)
                        <th style="width: 40%">Ad Soyad</th>
                        <th style="width: 40%">Departman</th>
                        <th class="text-right" style="width: 20%">Durum</th>
                        // En sağdaki sütunu sağa yasladık
                    }
                </tr>
            </thead>

            <tbody>
                @foreach (var item in Model.Employees)
                {
                    <tr>
                        <td style="display:none;">@item.Id</td>
                        <td style="vertical-align: middle;"><strong>@item.FirstName @item.LastName</strong></td>
                        <td style="vertical-align: middle;">
                            <span class="badge badge-secondary">@(item.Department?.Name ?? "-")</span>
                        </td>

                        @if (isAdmin)
                        {
                            // Admin Görünümü: Durum Ortada, İşlemler Sağda
                            <td style="vertical-align: middle;">
                                <span class="badge badge-success">Aktif</span>
                            </td>
                            <td class="text-right project-actions" style="vertical-align: middle;">
                                <a href="/Employee/Edit/@item.Id" class="btn btn-info btn-sm">
                                    <i class="fas fa-pencil-alt"></i> Düzenle
                                </a>
                                <a href="/Employee/Delete/@item.Id" class="btn btn-danger btn-sm" onclick="return confirm('Silinsin mi?')">
                                    <i class="fas fa-trash"></i> Sil
                                </a>
                            </td>
                        }
                        else
                        {
                            // User Görünümü: Durum en sağda ve sağa yaslı (text-right)
                            <td class="text-right" style="vertical-align: middle;">
                                <span class="badge badge-success">Aktif</span>
                            </td>
                        }
                    </tr>
                }
            </tbody>

        </table>
    </div>
</div>

@if (Model.ErrorInfo != null)
{
    <div class="modal fade" id="deleteErrorModal" tabindex="-1" role="dialog" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content bg-danger">
                <div class="modal-header">
                    <h4 class="modal-title"><i class="fas fa-exclamation-triangle mr-2"></i> @Model.ErrorInfo.EntityName Silinemedi!</h4>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                </div>
                <div class="modal-body" style="background-color: white; color: black;">
                    <p class="lead text-danger font-weight-bold">@Model.ErrorInfo.ErrorMessage</p>
                    <div class="table-responsive" style="max-height: 300px; overflow-y: auto;">
                        <table class="table table-sm table-bordered table-striped">
                            <thead class="thead-light"><tr><th>Zimmetli Demirbaş</th></tr></thead>
                            <tbody>
                                @foreach (var relate in Model.ErrorInfo.RelatedItems)
                                {
                                    <tr><td><i class="fas fa-box text-muted mr-2"></i> @relate</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="modal-footer"><button type="button" class="btn btn-secondary" data-dismiss="modal">Kapat</button></div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script src="~/plugins/datatables/jquery.dataTables.min.js"></script>
    <script src="~/plugins/datatables-bs4/js/dataTables.bootstrap4.min.js"></script>

    <script>
        $(document).ready(function () {
            if ($.fn.DataTable.isDataTable('#tblEmployees')) { $('#tblEmployees').DataTable().destroy(); }

            var table = $("#tblEmployees").DataTable({
                "responsive": true,
                "lengthChange": true,
                "autoWidth": false,
                "language": { "url": "https://cdn.datatables.net/plug-ins/1.10.25/i18n/Turkish.json" },
                "order": [[1, "asc"]],
                "columnDefs": [
                    { "targets": [0], "visible": false },
                    @if (isAdmin)
                    {
                                <text>{ "targets": [4], "orderable": false }</text>
                    }
                ]
            });

            @if (Model.ErrorInfo != null)
            {
                        <text>$('#deleteErrorModal').modal('show');</text>
            }
        });
    </script>
}