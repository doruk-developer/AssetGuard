@using AssetGuard.Entity
@model AssetGuard.WebUI.Models.EmployeeListViewModel

@{
    ViewData["Title"] = "Personel Listesi";
    Layout = "~/Views/Shared/_Layout.cshtml";

    // Rol Kontrolü
    bool isAdmin = User.IsInRole("Admin");
}

<style>
    /* 1. DataTables Oklarını Gizle */
    table.dataTable thead .sorting:before, table.dataTable thead .sorting:after,
    table.dataTable thead .sorting_asc:before, table.dataTable thead .sorting_asc:after,
    table.dataTable thead .sorting_desc:before, table.dataTable thead .sorting_desc:after {
        display: none !important;
    }

    /* 2. Başlık Stilleri */
    #tblEmployees thead th:not(.static-header) {
        cursor: pointer;
        transition: 0.2s;
        padding: 12px 8px !important;
        text-transform: uppercase;
        font-size: 0.85rem;
    }

        #tblEmployees thead th:not(.static-header):hover {
            background-color: #f4f6f9 !important;
            color: #007bff;
            text-decoration: underline;
        }

    #tblEmployees thead th.sorting_asc, #tblEmployees thead th.sorting_desc {
        color: #007bff;
        border-bottom: 2px solid #007bff !important;
    }

    /* 3. Statik Başlıklar */
    .static-header {
        cursor: default !important;
        pointer-events: none;
        color: #999 !important;
    }

    /* 4. SÖNÜK BUTON STİLİ (User İçin) */
    .disabled-action-btn {
        pointer-events: none !important;
        opacity: 0.5 !important;
        cursor: not-allowed !important;
        background-color: #6c757d !important;
        border-color: #6c757d !important;
        color: white !important;
        display: inline-block;
        padding: 0.25rem 0.5rem;
        font-size: 0.875rem;
        line-height: 1.5;
        border-radius: 0.2rem;
        text-align: center;
        vertical-align: middle;
        text-decoration: none;
    }
</style>

<div class="card">
    <div class="card-header border-0">
        <h3 class="card-title">Aktif Personel Kayıtları</h3>
        <div class="card-tools">
            <!-- YENİ PERSONEL BUTONU -->
            @if (isAdmin)
            {
                <a href="/Employee/Create" class="btn btn-primary btn-sm">
                    <i class="fas fa-user-plus"></i> Yeni Personel
                </a>
            }
            else
            {
                <!-- User için sönük -->
                <span class="disabled-action-btn">
                    <i class="fas fa-user-plus"></i> Yeni Personel
                </span>
            }
        </div>
    </div>

    <div class="card-body p-0">
        <table id="tblEmployees" class="table table-striped projects table-hover m-0">
            <thead>
                <tr>
                    <th style="display:none;">ID</th> <!-- Index 0 -->
                    <th style="width: 25%">Ad Soyad</th>
                    <th style="width: 25%">Departman</th>
                    <th style="width: 15%">Durum</th>
                    <!-- İşlemler: Herkes görür -->
                    <th class="static-header text-right" style="width: 20%">İşlemler</th> <!-- Index 4 -->
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Employees)
                {
                    <tr>
                        <td style="display:none;">@item.Id</td>
                        <td>
                            <strong>@item.FirstName @item.LastName</strong>
                        </td>
                        <td>
                            <span class="badge badge-secondary">@item.Department?.Name</span>
                        </td>
                        <td>
                            <span class="badge badge-success">Aktif</span>
                        </td>

                        <!-- BUTONLAR -->
                        <td class="project-actions text-right">

                            <!-- DÜZENLE -->
                            <a class="btn btn-sm @(isAdmin ? "btn-info" : "disabled-action-btn")"
                               href="/Employee/Edit/@item.Id">
                                <i class="fas fa-pencil-alt"></i> Düzenle
                            </a>

                            <!-- SİL -->
                            <a class="btn btn-sm @(isAdmin ? "btn-danger" : "disabled-action-btn")"
                               href="/Employee/Delete/@item.Id"
                               onclick="@(isAdmin ? "return confirm('" + item.FirstName + " isimli personeli silmek istediğinize emin misiniz?');" : "return false;")">
                                <i class="fas fa-trash"></i> Sil
                            </a>

                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- HATA MODALI (Aynen Korundu) -->
@if (Model.ErrorInfo != null)
{
    <div class="modal fade" id="deleteErrorModal" tabindex="-1" role="dialog" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content bg-danger">
                <div class="modal-header">
                    <h4 class="modal-title"><i class="fas fa-exclamation-triangle mr-2"></i> @Model.ErrorInfo.EntityName Silinemedi!</h4>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                </div>
                <div class="modal-body" style="background-color: white; color: black;">
                    <p class="lead text-danger font-weight-bold">@Model.ErrorInfo.ErrorMessage</p>
                    <div class="table-responsive" style="max-height: 300px; overflow-y: auto;">
                        <table class="table table-sm table-bordered table-striped">
                            <thead class="thead-light"><tr><th>Zimmetli Demirbaş</th></tr></thead>
                            <tbody>
                                @foreach (var item in Model.ErrorInfo.RelatedItems)
                                {
                                    <tr><td><i class="fas fa-box text-muted mr-2"></i> @item</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="modal-footer"><button type="button" class="btn btn-secondary" data-dismiss="modal">Kapat</button></div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script src="~/plugins/datatables/jquery.dataTables.min.js"></script>
    <script src="~/plugins/datatables-bs4/js/dataTables.bootstrap4.min.js"></script>

    <script>
        $(document).ready(function () {
            // Tabloyu sıfırla ve yeniden kur
            if ($.fn.DataTable.isDataTable('#tblEmployees')) { $('#tblEmployees').DataTable().destroy(); }

            $("#tblEmployees").DataTable({
                "responsive": true,
                "lengthChange": true,
                "autoWidth": false,
                "language": { "url": "https://cdn.datatables.net/plug-ins/1.10.25/i18n/Turkish.json" },
                "order": [[1, "asc"]], // İsime göre A-Z
                "columnDefs": [
                    { "targets": [0], "visible": false }, // ID Gizle
                    { "targets": [4], "orderable": false } // İşlemleri sıralamaya kapat
                ]
            });

            // Hata varsa modalı aç
            @if (Model.ErrorInfo != null)
            {
                <text>$('#deleteErrorModal').modal('show');</text>
            }
        });
    </script>
}