@*Personel oluşturma Form görünümü*@
@model AssetGuard.WebUI.Models.EmployeeAddViewModel

@{
    ViewData["Title"] = "Yeni Personel Kaydı";
}

<div class="row">
    <div class="col-md-8">
        <!-- Formu ortalamak için 8 kolon kullandık -->
        <div class="card card-primary">
            <div class="card-header">
                <h3 class="card-title">Yeni Personel Kayıt Formu</h3>
            </div>

            <form method="post">
                <div class="card-body">

                    <!-- 1. Ad -->
                    <div class="form-group">
                        <label>Adı</label>
                        <input type="text" class="form-control" asp-for="Employee.FirstName" placeholder="Örn: Ayşe">
                        <!-- Validasyon hata mesajı -->
                        <span asp-validation-for="Employee.FirstName" class="text-danger small font-weight-bold"></span>
                    </div>
                    

                    <!-- 2. Soyad -->
                    <div class="form-group">
                        <label>Soyadı</label>
                        <input type="text" class="form-control" asp-for="Employee.LastName" placeholder="Örn: Demir">
                        <!-- Validasyon hata mesajı -->
                        <span asp-validation-for="Employee.LastName" class="text-danger small font-weight-bold"></span>
                    </div>
                    
                    <!-- 3. Email -->
                    <div class="form-group">
                        <label>E-Posta Adresi</label>
                        <div class="input-group">
                            <div class="input-group-prepend">
                                <span class="input-group-text"><i class="fas fa-envelope"></i></span>
                            </div>
                            <input type="email" class="form-control" asp-for="Employee.Email" placeholder="ornek@sirket.com">
                        </div>
                        <!-- Validasyon hata mesajı -->
                        <span asp-validation-for="Employee.Email" class="text-danger small font-weight-bold" style="display:block; margin-top:5px;"></span>
                    </div>

                    <!-- 4. Departman (DROPDOWN) -->
                    <div class="form-group">
                        <label>Departman Seçin</label>
                        <!-- Seçilen ID, Employee.DepartmentID içine gidecek -->
                        <select class="form-control" asp-for="Employee.DepartmentId">
                            <option value="">-- Departman Seçiniz --</option>
                            @foreach (var item in Model.DepartmentList)
                            {
                                <option value="@item.Id">@item.Name</option>
                            }
                        </select>
                    </div>

                </div>

                <div class="card-footer">
                    <button type="submit" class="btn btn-success">Personeli Kaydet</button>
                    <a href="/Employee/Index" class="btn btn-secondary">İptal</a>
                </div>
            </form>
        </div>
    </div>
</div>
