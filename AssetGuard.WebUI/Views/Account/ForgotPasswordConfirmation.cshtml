@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Mail Gönderildi | AssetGuard</title>
    <link rel="stylesheet" href="~/dist/css/adminlte.min.css">
    <link rel="stylesheet" href="~/plugins/fontawesome-free/css/all.min.css">
</head>
<body class="hold-transition login-page">
    <div class="login-box">
        <div class="card card-outline card-success">
            <div class="card-header text-center">
                <a href="#" class="h1"><b>Asset</b>GUARD</a>
            </div>
            <div class="card-body">
                <div class="alert alert-success">
                    <h5><i class="icon fas fa-check"></i> İşlem Başarılı!</h5>
                    E-posta adresinize şifre sıfırlama talimatları gönderildi.
                </div>
                <p class="text-muted text-center text-sm">
                    (Simülasyon Modu: Visual Studio'da <b>Output</b> penceresine bakınız.)
                </p>
                <div class="row mt-3">
                    <div class="col-12">
                        <a href="/Account/Login" class="btn btn-block btn-secondary">Giriş Sayfasına Dön</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>