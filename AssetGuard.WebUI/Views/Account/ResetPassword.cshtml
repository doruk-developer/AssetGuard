@model AssetGuard.WebUI.Models.ResetPasswordViewModel

@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8">
    <title>Şifre Yenileme | AssetGuard</title>
    <link rel="stylesheet" href="~/dist/css/adminlte.min.css">
    <link rel="stylesheet" href="~/plugins/fontawesome-free/css/all.min.css">
</head>
<body class="hold-transition login-page">
    <div class="login-box">
        <div class="card card-outline card-primary">
            <div class="card-header text-center">
                <a href="#" class="h1"><b>Asset</b>GUARD</a>
            </div>
            <div class="card-body">
                <p class="login-box-msg">Lütfen yeni şifrenizi belirleyin.</p>

                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                <form asp-action="ResetPassword" method="post">

                    <!-- KRİTİK NOKTA: Verileri gizli inputlarla taşıyoruz -->
                    <input type="hidden" asp-for="Token" />
                    <input type="hidden" asp-for="Email" />

                    <div class="input-group mb-3">
                        <input type="password" asp-for="Password" class="form-control" placeholder="Yeni Şifre" required>
                        <div class="input-group-append">
                            <div class="input-group-text"><span class="fas fa-lock"></span></div>
                        </div>
                    </div>
                    <!-- Şifre Hatası Varsa Göster -->
                    <span asp-validation-for="Password" class="text-danger small"></span>

                    <div class="input-group mb-3">
                        <input type="password" asp-for="ConfirmPassword" class="form-control" placeholder="Şifre Tekrar" required>
                        <div class="input-group-append">
                            <div class="input-group-text"><span class="fas fa-lock"></span></div>
                        </div>
                    </div>
                    <!-- Uyuşmazlık Hatası Varsa Göster -->
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>

                    <div class="row mt-3">
                        <div class="col-12">
                            <button type="submit" class="btn btn-primary btn-block">Şifreyi Değiştir</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</body>
</html>