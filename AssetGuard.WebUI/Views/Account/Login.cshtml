@{
    Layout = null; // Bu sayfa ana temadan bağımsız olacak
    ViewData["Title"] = "Giriş Yap";
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>AssetGuard | Giriş</title>
    <!-- AdminLTE Stilleri -->
    <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Source+Sans+Pro:300,400,400i,700&display=fallback">
    <link rel="stylesheet" href="~/plugins/fontawesome-free/css/all.min.css">
    <link rel="stylesheet" href="~/dist/css/adminlte.min.css">
</head>
<body class="hold-transition login-page">

    <div class="login-box">
        <div class="card card-outline card-primary">
            <div class="card-header text-center">
                <!-- DİŞLİ LOGOMUZ -->
                <img src="~/dist/img/assetguard-logo.png" alt="Logo" class="mb-2" style="width: 70px;"><br>
                <a href="#" class="h1"><b>Asset</b>Guard</a>
            </div>
            <div class="card-body">
                <p class="login-box-msg">Yönetim paneline erişmek için giriş yapın</p>

                <!-- FORM BAŞLANGICI -->
                <form action="/Account/Login" method="post">

                    <!-- Eğer önceki sayfadan geldiyse (ReturnUrl) onu sakla -->
                    <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />

                    <div class="input-group mb-3">
                        <input type="text" name="username" class="form-control" placeholder="Kullanıcı Adı ...">
                        <div class="input-group-append">
                            <div class="input-group-text">
                                <span class="fas fa-user"></span>
                            </div>
                        </div>
                    </div>

                    <div class="input-group mb-3">
                        <input type="password" name="password" class="form-control" placeholder="Şifre ...">
                        <div class="input-group-append">
                            <div class="input-group-text">
                                <span class="fas fa-lock"></span>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-12">
                            <button type="submit" class="btn btn-primary btn-block">Giriş Yap</button>
                        </div>
                    </div>

                    <!-- HATA MESAJI ALANI -->
                    <div class="text-danger mt-3 text-center font-weight-bold">
                        @Html.ValidationSummary(true)
                    </div>

                </form>
            </div>
        </div>
    </div>

    <script src="~/plugins/jquery/jquery.min.js"></script>
    <script src="~/plugins/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/dist/js/adminlte.min.js"></script>
</body>
</html>