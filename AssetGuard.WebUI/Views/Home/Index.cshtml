@model AssetGuard.WebUI.Models.DashboardViewModel

@{
    ViewData["Title"] = "Genel Bakış";
}

<!-- 1. KPI KUTULARI (CANLI) -->
<div class="row">
    <div class="col-lg-3 col-6">
        <div class="small-box bg-info">
            <div class="inner">
                <h3>@Model.TotalAssetCount</h3>
                <p>Toplam Demirbaş</p>
            </div>
            <div class="icon"><i class="fas fa-boxes"></i></div>
            <a href="/Asset/Index" class="small-box-footer">Listeye Git <i class="fas fa-arrow-circle-right"></i></a>
        </div>
    </div>
    <div class="col-lg-3 col-6">
        <div class="small-box bg-danger">
            <div class="inner">
                <h3>@Model.TotalFaultyCount <small style="font-size: 0.5em">Cihaz</small></h3>
                <p>Arızalı / Bakımda</p>
            </div>
            <div class="icon"><i class="fas fa-tools"></i></div>
            <a href="/Report/Details?type=ariza" class="small-box-footer">Raporu Gör <i class="fas fa-arrow-circle-right"></i></a>
        </div>
    </div>
    <div class="col-lg-3 col-6">
        <div class="small-box bg-success">
            <div class="inner">
                <h3>@Model.TotalEmployeeCount <small style="font-size: 0.5em">Kişi</small></h3>
                <p>Kayıtlı Personel</p>
            </div>
            <div class="icon"><i class="fas fa-users"></i></div>
            <a href="/Employee/Index" class="small-box-footer">Personeller <i class="fas fa-arrow-circle-right"></i></a>
        </div>
    </div>
    <div class="col-lg-3 col-6">
        <div class="small-box bg-warning">
            <div class="inner">
                <h3>₺ @Model.TotalInventoryValue.ToString("N0")</h3>
                <p>Envanter Değeri</p>
            </div>
            <div class="icon"><i class="fas fa-coins"></i></div>
            <a href="/Report/Details?type=mali" class="small-box-footer">Mali Analiz <i class="fas fa-arrow-circle-right"></i></a>
        </div>
    </div>
</div>

<!-- 2. GRAFİKLER (CANLI) -->
<div class="row">
    <div class="col-lg-7">
        <div class="card">
            <div class="card-header border-0">
                <h3 class="card-title">Harcama Trendi (Son 5 Yıl)</h3>
            </div>
            <div class="card-body">
                <canvas id="purchaseChart" height="200"></canvas>
            </div>
        </div>
    </div>
    <div class="col-lg-5">
        <div class="card">
            <div class="card-header border-0">
                <h3 class="card-title">Kategori Dağılımı</h3>
            </div>
            <div class="card-body">
                <canvas id="donutChart" style="min-height: 250px; height: 250px; max-height: 250px; max-width: 100%;"></canvas>
            </div>
        </div>
    </div>
</div>

<!-- 3. ALT TABLOLAR (ŞİMDİLİK STATİK - GÖRSEL DOLULUK İÇİN) -->
<div class="row">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header border-transparent">
                <h3 class="card-title">Son Zimmet Hareketleri</h3>
                <div class="card-tools">
                    <button type="button" class="btn btn-tool" data-card-widget="collapse"><i class="fas fa-minus"></i></button>
                </div>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table m-0">
                        <thead><tr><th>ID</th><th>Ürün</th><th>Durum</th><th>Personel</th></tr></thead>
                        <tbody>
                            @foreach (var item in Model.LastAssignments)
                            {
                                <tr>
                                    <td><a href="#">#@item.Id</a></td>
                                    <td>
                                        <!-- Null Check ile güvenli hale getirelim -->
                                        @(item.Asset != null ? item.Asset.AssetName : "Silinmiş Ürün")
                                    </td>
                                    <td>
                                        @if (item.ReturnDate == null)
                                        {
                                            <span class="badge badge-success">Aktif Zimmet</span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-secondary">İade Alındı</span>
                                        }
                                    </td>
                                    <td>
                                        @(item.Employee != null ? item.Employee.FirstName + " " + item.Employee.LastName : "Silinmiş Personel")
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="card-footer clearfix">
                <a href="/Assignment/Create" class="btn btn-sm btn-info float-left">Yeni Zimmet</a>
                <a href="/Assignment/Index" class="btn btn-sm btn-secondary float-right">Tüm Geçmiş</a>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Envantere Yeni Girenler</h3>
            </div>
            <div class="card-body p-0">
                <ul class="products-list product-list-in-card pl-2 pr-2">
                    @foreach (var item in Model.NewAssets)
                    {
                        <li class="item">
                            <div class="product-img">
                                <!-- Resim yoksa varsayılan ikon göster -->
                                <img src="~/dist/img/default-150x150.png" alt="Product Image" class="img-size-50">
                            </div>
                            <div class="product-info">
                                <a href="javascript:void(0)" class="product-title">
                                    @item.AssetName
                                    <span class="badge badge-warning float-right">₺@item.Price.ToString("N0")</span>
                                </a>
                                <span class="product-description">
                                    @item.Category?.Name / @item.SerialNo
                                </span>
                            </div>
                        </li>
                    }
                </ul>
            </div>
            <div class="card-footer text-center">
                <a href="/Asset/Index" class="uppercase">Tüm Ürünleri Gör</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(function () {
            // VERİLERİ JS'E AKTAR
            var catLabels = @Html.Raw(Json.Serialize(Model.CategoryLabels));
            var catValues = @Html.Raw(Json.Serialize(Model.CategoryValues));
            var monthLabels = @Html.Raw(Json.Serialize(Model.MonthlyLabels));
            var monthValues = @Html.Raw(Json.Serialize(Model.MonthlyValues));

            // -- DONUT CHART --
             // 1. Kullanıcının tercihini oku (Yoksa varsayılan 'doughnut' olsun)
            var userChartType = localStorage.getItem('assetGuard_chartType') || 'doughnut';

            var donutChartCanvas = $('#donutChart').get(0).getContext('2d')
            new Chart(donutChartCanvas, {
                type: userChartType, // BURASI ARTIK DİNAMİK! ('bar' veya 'doughnut' gelir)
                data: {
                    labels: catLabels,
                    datasets: [{
                        data: catValues,
                        backgroundColor: ['#f56954', '#00a65a', '#f39c12', '#00c0ef', '#3c8dbc', '#d2d6de'],
                    }]
                },
                options: {
                    maintainAspectRatio: false,
                    responsive: true,
                    // Eğer Bar chart seçilirse Y ekseni 0'dan başlasın
                    scales: {
                        yAxes: userChartType === 'bar' ? [{ ticks: { beginAtZero: true } }] : []
                    }
                }
            })

            // -- LINE CHART (Aylık) --
            var lineChartCanvas = $('#purchaseChart').get(0).getContext('2d')
            new Chart(lineChartCanvas, {
                type: 'line',
                data: {
                    labels: monthLabels,
                    datasets: [{
                        label: 'Harcama (TL)',
                        backgroundColor: 'rgba(60,141,188,0.2)',
                        borderColor: 'rgba(60,141,188,1)',
                        pointRadius: 3,
                        pointBackgroundColor: 'rgba(60,141,188,1)',
                        data: monthValues,
                        fill: true
                    }]
                },
                options: {
                    maintainAspectRatio: false,
                    responsive: true,
                    scales: {
                        yAxes: [{ ticks: { beginAtZero: true } }]
                    }
                }
            })
        })
    </script>
}