@model AssetGuard.WebUI.Models.DashboardViewModel
@{
    ViewData["Title"] = "Genel Bakış";
}

<!-- 1. FİLTRELEME PANELİ (TOGGLE SİSTEMLİ) -->
<div class="card mb-4 shadow-sm border-0">
    <div class="card-body p-2 bg-light rounded">
        <div class="row align-items-center">
            <!-- Anahtar -->
            <div class="col-md-3 border-right">
                <div class="custom-control custom-switch mt-1">
                    <input type="checkbox" class="custom-control-input" id="filterToggle">
                    <label class="custom-control-label font-weight-bold text-dark" for="filterToggle">Detaylı Filtreleme</label>
                </div>
            </div>
            <!-- Yıl -->
            <div class="col-md-3">
                <select id="filterYear" class="form-control form-control-sm" disabled>
                    <option value="0" selected>Tüm Yıllar</option>
                    <option value="2025">2025</option>
                    <option value="2024">2024</option>
                    <option value="2023">2023</option>
                </select>
            </div>
            <!-- Kategori -->
            <div class="col-md-3">
                <select id="filterCategory" class="form-control form-control-sm" disabled>
                    <option value="0" selected>Tüm Kategoriler</option>
                    @if (Model.CategoryList != null)
                    {
                        foreach (var cat in Model.CategoryList)
                        {
                            <option value="@cat.Id">@cat.Name</option>
                        }
                    }
                </select>
            </div>
            <!-- Buton -->
            <div class="col-md-2">
                <button id="btnUpdate" class="btn btn-secondary btn-sm w-100" onclick="updateDashboard(this)">
                    <i class="fas fa-sync-alt mr-1"></i> <span id="btnText">Tümünü Göster</span>
                </button>
            </div>
        </div>
    </div>
</div>

<!-- 2. BİLGİ KARTLARI (KPI BOXES) -->
<div class="row">
    <div class="col-lg-3 col-6">
        <div class="small-box bg-info">
            <div class="inner">
                <h3 id="lblTotalCount">@Model.TotalAssetCount</h3>
                <p>Toplam Demirbaş</p>
            </div>
            <div class="icon"><i class="fas fa-boxes"></i></div>
            <a href="/Asset/Index" class="small-box-footer">Listeye Git <i class="fas fa-arrow-circle-right"></i></a>
        </div>
    </div>
    <div class="col-lg-3 col-6">
        <div class="small-box bg-danger">
            <div class="inner">
                <h3 id="lblBroken">@Model.TotalFaultyCount</h3>
                <p>Arızalı / Bakımda</p>
            </div>
            <div class="icon"><i class="fas fa-tools"></i></div>
            <a href="/Report/Index" class="small-box-footer">Raporu Gör <i class="fas fa-arrow-circle-right"></i></a>
        </div>
    </div>
    <div class="col-lg-3 col-6">
        <div class="small-box bg-success">
            <div class="inner">
                <h3>@Model.TotalEmployeeCount</h3>
                <p>Kayıtlı Personel</p>
            </div>
            <div class="icon"><i class="fas fa-users"></i></div>
            <a href="/Employee/Index" class="small-box-footer">Personeller <i class="fas fa-arrow-circle-right"></i></a>
        </div>
    </div>
    <div class="col-lg-3 col-6">
        <div class="small-box bg-warning">
            <div class="inner">
                <h3 id="lblTotalValue">@Model.TotalInventoryValue.ToString("C0")</h3>
                <p>Envanter Değeri</p>
            </div>
            <div class="icon"><i class="fas fa-coins"></i></div>
            <a href="#" class="small-box-footer">Mali Analiz <i class="fas fa-arrow-circle-right"></i></a>
        </div>
    </div>
</div>

<!-- 3. GRAFİKLER (Harcama Trendi ve Kategori Dağılımı) -->
<div class="row">
    <!-- SOL: Çizgi Grafik (Line Chart) -->
    <div class="col-md-8">
        <div class="card card-primary card-outline">
            <div class="card-header">
                <h3 class="card-title"><i class="fas fa-chart-line mr-1"></i> Harcama Trendi (Aylık)</h3>
            </div>
            <div class="card-body">
                <div class="chart">
                    <canvas id="revenue-chart-canvas" style="height: 300px;"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- SAĞ: Pasta Grafik (Donut Chart) - GERİ GELDİ -->
    <div class="col-md-4">
        <div class="card card-info card-outline">
            <div class="card-header">
                <h3 class="card-title">Kategori Dağılımı</h3>
            </div>
            <div class="card-body">
                <canvas id="donutChart" style="min-height: 250px; height: 250px; max-height: 250px; max-width: 100%;"></canvas>
            </div>
        </div>
    </div>
</div>

<!-- 4. ALT TABLOLAR (Zimmetler ve Yeni Girenler) - GERİ GELDİ -->
<div class="row">
    <!-- Sol: Son Zimmet Hareketleri -->
    <div class="col-md-8">
        <div class="card">
            <div class="card-header border-transparent">
                <h3 class="card-title">Son Zimmet Hareketleri</h3>
                <div class="card-tools">
                    <button type="button" class="btn btn-tool" data-card-widget="collapse">
                        <i class="fas fa-minus"></i>
                    </button>
                </div>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table m-0">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Ürün</th>
                                <th>Durum</th>
                                <th>Personel</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.LastAssignments != null)
                            {
                                foreach (var item in Model.LastAssignments)
                                {
                                    <tr>
                                        <td><a href="#">#@item.Id</a></td>
                                        <td>@(item.Asset?.AssetName ?? "-")</td>
                                        <td><span class="badge badge-success">Aktif Zimmet</span></td>
                                        <td>@(item.Employee?.FirstName + " " + item.Employee?.LastName)</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="card-footer clearfix">
                <a href="/Assignment/Create" class="btn btn-sm btn-info float-left">Yeni Zimmet</a>
                <a href="/Assignment/Index" class="btn btn-sm btn-secondary float-right">Tüm Geçmiş</a>
            </div>
        </div>
    </div>

    <!-- Sağ: Envantere Yeni Girenler -->
    <div class="col-md-4">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Envantere Yeni Girenler</h3>
            </div>
            <div class="card-body p-0">
                <ul class="products-list product-list-in-card pl-2 pr-2">
                    @if (Model.NewAssets != null)
                    {
                        foreach (var item in Model.NewAssets)
                        {
                            <li class="item">
                                <div class="product-img">
                                    <div class="img-circle img-size-50 bg-secondary d-flex align-items-center justify-content-center" style="height:50px; width:50px;">
                                        <i class="fas fa-box"></i>
                                    </div>
                                </div>
                                <div class="product-info">
                                    <a href="/Asset/Details/@item.Id" class="product-title">
                                        @item.AssetName
                                        <span class="badge badge-warning float-right">@item.Price.ToString("C0")</span>
                                    </a>
                                    <span class="product-description">
                                        @(item.Category?.Name ?? "-") / @item.SerialNo
                                    </span>
                                </div>
                            </li>
                        }
                    }
                </ul>
            </div>
            <div class="card-footer text-center">
                <a href="/Asset/Index" class="uppercase">Tüm Ürünleri Gör</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- ChartJS Kütüphanesi -->
    <script src="~/plugins/chart.js/Chart.min.js"></script>

    <script>
        // Global grafik değişkenleri
        var dashboardChart = null;
        var categoryChart = null;

        $(document).ready(function() {
            // 1. Sayfa Açılışında Çizgi Grafiği Getir (Tüm Veriler)
            updateDashboard(null);

            // 2. Kategori Grafiği Verilerini Model'den Güvenli Şekilde Al
            // JSON Serialization tırnak hatalarını önler.
            var catLabels = JSON.parse('@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CategoryLabels))');
            var catValues = JSON.parse('@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CategoryValues))');

            // Ayarlardan gelen tercih (bar veya doughnut)
            var chartTypePref = '@(Model.ChartPreference ?? "doughnut")';

            // Kategori grafiğini çiz
            initDynamicChart(catLabels, catValues, chartTypePref);

            // 3. Toggle (Filtre Aç/Kapa) Değişimi
            $('#filterToggle').change(function() {
                var isActive = $(this).is(':checked');
                $('#filterYear, #filterCategory').prop('disabled', !isActive);

                if(isActive) {
                    $('#btnUpdate').removeClass('btn-secondary').addClass('btn-primary');
                    $('#btnText').text('Filtrele ve Getir');
                } else {
                    // Kapatılınca sıfırla ve hepsini getir
                    $('#filterYear').val(0);
                    $('#filterCategory').val(0);
                    $('#btnUpdate').removeClass('btn-primary').addClass('btn-secondary');
                    $('#btnText').text('Tümünü Göster');
                    updateDashboard(null);
                }
            });
        });

        // --- FİLTRELEME VE GÜNCELLEME FONKSİYONU ---
        function updateDashboard(sender) {
            var year = $('#filterYear').val();
            var catId = $('#filterCategory').val();

            var btn = sender;
            var orgHtml = "";

            // Butona basıldıysa loading efekti yap
            if (btn) {
                orgHtml = btn.innerHTML;
                btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i>';
                btn.disabled = true;
            }

            $.ajax({
                url: '/Home/GetFilterStats',
                type: 'GET',
                data: { year: year, categoryId: catId },
                success: function (res) {
                    // Kartları Güncelle
                    $('#lblTotalCount').text(res.totalAssetCount);
                    $('#lblBroken').text(res.brokenAssetCount);
                    $('#lblTotalValue').text(res.totalValue);

                    // Çizgi Grafiği Güncelle
                    renderLineChart(res.chartLabels, res.chartValues);

                    if (btn) toastr.success('Veriler güncellendi.');
                },
                error: function () {
                    toastr.error('Veri alınırken hata oluştu.');
                },
                complete: function () {
                    if (btn) {
                        btn.innerHTML = orgHtml;
                        btn.disabled = false;
                    }
                }
            });
        }

        // --- SOL TARAF: ÇİZGİ GRAFİK (HARCAMA TRENDİ) ---
        function renderLineChart(labels, data) {
            var canvas = document.getElementById('revenue-chart-canvas');
            if (!canvas) return;

            var ctx = canvas.getContext('2d');

            // Varsa eski grafiği temizle
            if (dashboardChart) dashboardChart.destroy();

            dashboardChart = new Chart(ctx, {
                type: 'line',
                data: {
                    labels: labels,
                    datasets: [{
                        label: 'Harcama Trendi',
                        backgroundColor: 'rgba(60,141,188,0.2)',
                        borderColor: 'rgba(60,141,188,1)',
                        pointRadius: 3,
                        pointBackgroundColor: '#3b8bba',
                        data: data,
                        fill: true
                    }]
                },
                options: {
                    maintainAspectRatio: false,
                    responsive: true,
                    legend: { display: false },
                    scales: {
                        xAxes: [{ gridLines: { display: false } }],
                        yAxes: [{ gridLines: { display: true } }]
                    },
                    tooltips: {
                        callbacks: {
                            label: function(tooltipItem) {
                                return "₺ " + Number(tooltipItem.yLabel).toLocaleString('tr-TR');
                            }
                        }
                    }
                }
            });
        }

        // --- SAĞ TARAF: DİNAMİK KATEGORİ GRAFİĞİ (Bar veya Doughnut) ---
        function initDynamicChart(labels, data, chartType) {
            var canvasJquery = $('#donutChart');
            if (canvasJquery.length === 0) return;

            var ctx = canvasJquery.get(0).getContext('2d');

            // Renk Paleti
            var colors = ['#f56954', '#00a65a', '#f39c12', '#00c0ef', '#3c8dbc', '#d2d6de', '#39cccc', '#605ca8'];

            // Grafik Tipine Göre Ayarlar
            var isBar = (chartType === 'bar');

            var chartOptions = {
                maintainAspectRatio : false,
                responsive : true,
                legend: { display: !isBar }, // Bar ise lejantı gizle, Pasta ise göster
                scales: {
                    // Bar ise eksenleri aç, Pasta ise kapat
                    xAxes: [{ display: isBar, gridLines: { display: false } }],
                    yAxes: [{ display: isBar, ticks: { beginAtZero: true } }]
                }
            };

            // Eski grafik varsa temizle (Tekrar çizimlerde üst üste binmemesi için)
            if (categoryChart) categoryChart.destroy();

            categoryChart = new Chart(ctx, {
                type: chartType,
                data: {
                    labels: labels,
                    datasets: [{
                        label: 'Ürün Sayısı',
                        data: data,
                        backgroundColor: colors,
                        borderWidth: 1
                    }]
                },
                options: chartOptions
            });
        }
    </script>
}