@using Microsoft.AspNetCore.Identity
@using AssetGuard.Entity
@using AssetGuard.WebUI.Models
@using System.Text.Json
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment Env

@{
    // --- GÜVENLİ BAŞLANGIÇ (SAFE MODE) ---
    var settings = new UserThemeSettings();
    string bodyClass = "";
    string navbarClass = "navbar-white navbar-light";
    string sidebarModeClass = "sidebar-dark-primary";
    string customSidebarStyle = "";

    try
    {
        if (User.Identity != null && User.Identity.IsAuthenticated)
        {
            var userName = User.Identity.Name;
            // System.IO.Path kullanarak çakışmayı önlüyoruz
            string folderPath = System.IO.Path.Combine(Env.ContentRootPath, "ThemeData");
            string filePath = System.IO.Path.Combine(folderPath, $"{userName}_settings.json");

            if (System.IO.File.Exists(filePath))
            {
                string jsonContent = System.IO.File.ReadAllText(filePath);
                settings = JsonSerializer.Deserialize<UserThemeSettings>(jsonContent) ?? new UserThemeSettings();
            }

            // 1. Dark Mode
            if (settings.IsDarkMode)
            {
                bodyClass = "dark-mode";
                navbarClass = "navbar-dark";
            }

            // 2. Sidebar Metin Rengi (Koyu/Açık)
            var lightColors = new[] { "white", "warning", "teal", "light" };
            bool isLightSidebar = lightColors.Contains((settings.SidebarColor ?? "").ToLower());
            sidebarModeClass = isLightSidebar ? "sidebar-light-primary" : "sidebar-dark-primary";

            // 3. Sidebar Arkaplan Rengi
            var colorMap = new Dictionary<string, string> {
                {"primary", "#007bff"}, {"secondary", "#6c757d"}, {"success", "#28a745"},
                {"danger", "#dc3545"}, {"warning", "#ffc107"}, {"info", "#17a2b8"},
                {"dark", "#343a40"}, {"indigo", "#6610f2"}, {"navy", "#001f3f"},
                {"purple", "#6f42c1"}, {"teal", "#20c997"}, {"white", "#ffffff"}
            };

            if (settings.SidebarColor != "default" && !string.IsNullOrEmpty(settings.SidebarColor) && colorMap.TryGetValue(settings.SidebarColor, out var hex))
            {
                customSidebarStyle = $"background-color: {hex} !important;";
            }
        }
    }
    catch
    {
        // Hata durumunda varsayılan (Clean) açılış
    }
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>AssetGuard | @ViewData["Title"]</title>

    <!-- Stil Dosyaları -->
    <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Source+Sans+Pro:300,400,400i,700&display=fallback">
    <link rel="stylesheet" href="~/plugins/fontawesome-free/css/all.min.css">
    <link rel="stylesheet" href="~/dist/css/adminlte.min.css">
    <link rel="stylesheet" href="~/plugins/overlayScrollbars/css/OverlayScrollbars.min.css">
    <link rel="stylesheet" href="~/plugins/toastr/toastr.css" />
    <link rel="stylesheet" href="~/plugins/datatables-bs4/css/dataTables.bootstrap4.min.css">

    <style>
        body {
            font-family: "Segoe UI", "Roboto", "Helvetica Neue", Arial, sans-serif !important;
        }

        .nav-sidebar .nav-link {
            border-radius: 8px;
            margin-bottom: 4px;
            transition: all 0.2s;
        }

        .card {
            border-radius: 8px;
            border: none;
            box-shadow: 0 0 15px rgba(0,0,0,0.05);
        }
        /* AdminLTE düzeltmeleri */
        .bg-warning {
            color: #1f2d3d !important;
        }

        /* --- DARK MODE DÜZELTMELERİ (Force Override) --- */

        /* 1. Input Alanları: Koyu zemin, Beyaz yazı */
        /* .card-body ekleyerek önceliği artırıyoruz */
        body.dark-mode .card-body .form-control,
        body.dark-mode .modal-body .form-control,
        body.dark-mode .custom-select,
        body.dark-mode input.form-control,
        body.dark-mode textarea.form-control {
            background-color: #343a40 !important; /* Koyu Gri */
            color: #ffffff !important; /* Beyaz Yazı */
            border: 1px solid #6c757d !important; /* Gri Çerçeve */
        }

            /* 2. Input Odaklanınca (Focus) */
            body.dark-mode .form-control:focus,
            body.dark-mode .custom-select:focus {
                background-color: #3f474e !important;
                border-color: #007bff !important; /* Mavi Vurgu */
                color: #ffffff !important;
                box-shadow: 0 0 0 0.2rem rgba(0,123,255,.25) !important;
            }

        /* 3. Tablo Satırları (Striped) */
        body.dark-mode .table-striped tbody tr:nth-of-type(odd) {
            background-color: rgba(255,255,255,0.05) !important;
        }

        /* 4. Placeholder Rengi (Silik Yazı) */
        body.dark-mode .form-control::placeholder {
            color: #adb5bd !important;
            opacity: 1;
        }

        /* 5. Readonly Inputlar (Gri Görünmesin) */
        body.dark-mode .form-control[readonly],
        body.dark-mode .form-control:disabled {
            background-color: #2c3034 !important;
            opacity: 1;
        }

    </style>
</head>

<body class="hold-transition sidebar-mini layout-fixed @bodyClass">
    <div class="wrapper">

        <!-- Navbar -->
        <nav class="main-header navbar navbar-expand @navbarClass">
            <ul class="navbar-nav">
                <li class="nav-item"><a class="nav-link" data-widget="pushmenu" href="#" role="button"><i class="fas fa-bars"></i></a></li>
                <li class="nav-item d-none d-sm-inline-block"><a href="/" class="nav-link">Ana Sayfa</a></li>
            </ul>
            <ul class="navbar-nav ml-auto">
                <li class="nav-item">
                    <a class="nav-link" data-widget="fullscreen" href="#" role="button"><i class="fas fa-expand-arrows-alt"></i></a>
                </li>
            </ul>
        </nav>

        <!-- Sidebar -->
        <aside class="main-sidebar @sidebarModeClass elevation-4" style="@customSidebarStyle">
            <a href="/" class="brand-link" style="@customSidebarStyle">
                <img src="~/dist/img/assetguard-logo.png" alt="AG" class="brand-image img-circle elevation-3" style="opacity: .8">
                <span class="brand-text font-weight-bold">ASSETGUARD</span>
            </a>
            <partial name="_Sidebar" />
        </aside>

        <!-- İçerik -->
        <div class="content-wrapper">
            <div class="content-header">
                <div class="container-fluid">
                    <div class="row mb-2">
                        <div class="col-sm-6"><h1 class="m-0">@ViewData["Title"]</h1></div>
                    </div>
                </div>
            </div>
            <section class="content">
                <div class="container-fluid">
                    @RenderBody()
                </div>
            </section>
        </div>

        <footer class="main-footer">
            <strong>Copyright &copy; @DateTime.Now.Year AssetGuard.</strong>
        </footer>
    </div>

    <!-- SCRIPTS (SIRALAMA ÇOK ÖNEMLİ) -->
    <script src="~/plugins/jquery/jquery.min.js"></script>
    <script src="~/plugins/bootstrap/js/bootstrap.bundle.min.js"></script>

    <!-- ChartJS Dashboard Hatası için Buraya Eklendi -->
    <script src="~/plugins/chart.js/Chart.min.js"></script>

    <script src="~/dist/js/adminlte.js"></script>
    <script src="~/plugins/toastr/toastr.min.js"></script>
    <script src="~/plugins/datatables/jquery.dataTables.min.js"></script>
    <script src="~/plugins/datatables-bs4/js/dataTables.bootstrap4.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

    <script>
        $(document).ready(function () {
            toastr.options = { "closeButton": true, "progressBar": true, "positionClass": "toast-top-right", "timeOut": "4000" };

            var success = '@TempData["SuccessMessage"]';
            if (success) toastr.success(success);

            var error = '@TempData["ErrorMessage"]';
            if (error) toastr.error(error);
        });
    </script>
</body>
</html>