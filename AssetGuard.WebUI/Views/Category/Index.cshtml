@using AssetGuard.WebUI.Models
@model CategoryListViewModel
@{
    ViewData["Title"] = "Kategori Yönetimi";
    Layout = "~/Views/Shared/_Layout.cshtml";
    bool isAdmin = User.IsInRole("Admin");
}

<div class="card">
    <div class="card-header border-0">
        <h3 class="card-title">Tüm Kategoriler</h3>
        <div class="card-tools">
            @if (isAdmin)
            {
                <a href="/Category/Create" class="btn btn-primary btn-sm">
                    <i class="fas fa-plus mr-1"></i> Yeni Kategori Ekle
                </a>
            }
        </div>
    </div>

    <div class="card-body p-0">
        <!-- Tablo Genişliği %100 Olarak Sabitlendi -->
        <table id="categoryTable" class="table table-striped projects table-hover m-0" style="width:100% !important;">
            <thead>
                <tr>
                    <th style="display:none;">ID</th>
                    @if (isAdmin)
                    {
                        <th style="width: 80%">KATEGORİ ADI</th>
                        <th class="text-right" style="width: 20%">İşlemler</th>
                    }
                    else
                    {
                        <th style="width: 100%">KATEGORİ ADI</th>
                    }
                </tr>
            </thead>

            <tbody>
                @* HATA DÜZELTİLDİ: Model üzerinden değil Model.Categories üzerinden dönüyoruz *@
                @foreach (var item in Model.Categories)
                {
                    <tr>
                        <td style="display:none;">@item.Id</td>
                        <td style="vertical-align: middle;">
                            <strong>@item.Name</strong>
                        </td>

                        @if (isAdmin)
                        {
                            <td class="text-right project-actions" style="vertical-align: middle;">
                                <a href="/Category/Edit/@item.Id" class="btn btn-info btn-sm">
                                    <i class="fas fa-pencil-alt"></i> Düzenle
                                </a>
                                <a href="/Category/Delete/@item.Id" class="btn btn-danger btn-sm" onclick="return confirm('Kategoriyi silmek istediğinize emin misiniz?')">
                                    <i class="fas fa-trash"></i> Sil
                                </a>
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- HATA MODALI (Sadece ErrorInfo doluysa oluşur) -->
@if (Model.ErrorInfo != null)
{
    <div class="modal fade" id="deleteErrorModal" tabindex="-1" role="dialog" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content bg-danger">
                <div class="modal-header">
                    <h4 class="modal-title"><i class="fas fa-exclamation-triangle mr-2"></i> @Model.ErrorInfo.EntityName Silinemedi!</h4>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                </div>
                <div class="modal-body" style="background-color: white; color: black;">
                    <p class="lead text-danger font-weight-bold">@Model.ErrorInfo.ErrorMessage</p>
                    <div class="table-responsive" style="max-height: 300px; overflow-y: auto;">
                        <table class="table table-sm table-bordered table-striped">
                            <thead class="thead-light"><tr><th>İlişkili Demirbaşlar</th></tr></thead>
                            <tbody>
                                @foreach (var relate in Model.ErrorInfo.RelatedItems)
                                {
                                    <tr><td><i class="fas fa-box text-muted mr-2"></i> @relate</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="modal-footer"><button type="button" class="btn btn-secondary" data-dismiss="modal">Kapat</button></div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script src="~/plugins/datatables/jquery.dataTables.min.js"></script>
    <script src="~/plugins/datatables-bs4/js/dataTables.bootstrap4.min.js"></script>

    <style>
        /* 1. DataTables Sıralama Oklarını (Before/After) Tamamen Gizle */
        table.dataTable thead .sorting:before,
        table.dataTable thead .sorting:after,
        table.dataTable thead .sorting_asc:before,
        table.dataTable thead .sorting_asc:after,
        table.dataTable thead .sorting_desc:before,
        table.dataTable thead .sorting_desc:after {
            display: none !important;
        }

        /* 2. Başlık Stilleri - Yazı tıklandığında hala sıralama çalışır */
        #categoryTable thead th:not(.static-header) {
            cursor: pointer;
            transition: 0.2s;
            padding: 12px 8px !important;
            text-transform: uppercase;
            font-size: 0.85rem;
        }

            #categoryTable thead th:not(.static-header):hover {
                background-color: #f4f6f9 !important;
                color: #007bff;
            }

        /* 3. Statik Başlıklar (İşlemler gibi) */
        .static-header {
            cursor: default !important;
            pointer-events: none;
            color: #999 !important;
        }
    </style>
}