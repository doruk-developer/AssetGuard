@using AssetGuard.Entity
@model List<Department>

@{
    ViewData["Title"] = "Departman Yönetimi";
}

<div class="card">
    <div class="card-header">
        <h3 class="card-title">Tüm Departmanlar</h3>
        <div class="card-tools">
            <a href="#" class="btn btn-primary btn-sm">
                <i class="fas fa-plus"></i> Yeni Departman Ekle
            </a>
        </div>
    </div>

    <div class="card-body p-0">
        <table class="table table-striped projects table-hover">
            <thead>
                <tr>
                    <th style="width: 10%">ID</th>
                    <th style="width: 70%">Departman Adı</th>
                    <th style="width: 20%">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Id</td>
                        <td><strong>@item.Name</strong></td>
                        <td class="project-actions text-right">
                            <a class="btn btn-info btn-sm" href="#"><i class="fas fa-pencil-alt"></i></a>
                            <a class="btn btn-danger btn-sm" href="#"><i class="fas fa-trash"></i></a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>