@using AssetGuard.Entity
@model AssetGuard.WebUI.Models.DepartmentListViewModel

@{
    ViewData["Title"] = "Departman Yönetimi";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    /* 1. OK İŞARETLERİNİ KALDIR */
    table.dataTable thead .sorting:before, table.dataTable thead .sorting:after,
    table.dataTable thead .sorting_asc:before, table.dataTable thead .sorting_asc:after,
    table.dataTable thead .sorting_desc:before, table.dataTable thead .sorting_desc:after {
        display: none !important;
    }

    /* 2. VERİ BAŞLIKLARI: Tıklanabilir Efektler */
    #tblDepartments thead th:not(.no-export) {
        cursor: pointer;
        color: #444;
        transition: all 0.2s ease;
        position: relative;
    }

        #tblDepartments thead th:not(.no-export):hover {
            background-color: #f0f4f8 !important;
            color: #007bff !important;
        }

    #tblDepartments thead th.sorting_asc, #tblDepartments thead th.sorting_desc {
        color: #007bff !important;
        border-bottom: 2px solid #007bff !important;
    }

    /* 3. İŞLEMLER BAŞLIĞI: Tamamen Statik (Tıklama Hissiyatı Yok) */
    #tblDepartments thead th.no-export {
        cursor: default !important;
        pointer-events: none; /* Tıklama sinyalini tamamen keser */
        color: #999 !important; /* Bir tık daha silik renk */
        text-decoration: none !important;
    }
</style>

<div class="card">
    <div class="card-header border-0">
        <h3 class="card-title">Sistem Departmanları</h3>
        <div class="card-tools">
            <a href="/Department/Create" class="btn btn-primary btn-sm"><i class="fas fa-plus"></i> Yeni Departman Ekle</a>
        </div>
    </div>
    <div class="card-body p-0">
        <table id="tblDepartments" class="table table-striped projects table-hover m-0">
            <thead>
                <tr>
                    <th style="display:none;">ID</th>
                    <th>Departman Adı</th>
                    <th class="text-right no-export">İşlemler</th> <!-- no-export class'ı eklendi -->
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Departments)
                {
                    <tr>
                        <td style="display:none;">@item.Id</td>
                        <td><strong>@item.Name</strong></td>
                        <td class="text-right">
                            <a class="btn btn-info btn-sm" href="/Department/Edit/@item.Id"><i class="fas fa-pencil-alt"></i></a>
                            <a class="btn btn-danger btn-sm" href="/Department/Delete/@item.Id" onclick="return confirm('Silmek istediğinize emin misiniz?');"><i class="fas fa-trash"></i></a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (Model.ErrorInfo != null)
{
    <div class="modal fade" id="deleteErrorModal" tabindex="-1" role="dialog" aria-hidden="true">
        <div class="modal-dialog modal-lg text-dark">
            <div class="modal-content bg-danger">
                <div class="modal-header">
                    <h4 class="modal-title"><i class="fas fa-exclamation-triangle mr-2"></i> @Model.ErrorInfo.EntityName Silinemedi!</h4>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                </div>
                <div class="modal-body bg-white">
                    <p class="lead text-danger font-weight-bold">@Model.ErrorInfo.ErrorMessage</p>
                    <table class="table table-sm table-bordered">
                        <thead><tr><th>Departmana Bağlı Personeller</th></tr></thead>
                        <tbody>
                            @foreach (var item in Model.ErrorInfo.RelatedItems)
                            {
                                <tr><td>@item</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="modal-footer bg-light"><button type="button" class="btn btn-secondary" data-dismiss="modal">Kapat</button></div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script src="~/plugins/datatables/jquery.dataTables.min.js"></script>
    <script src="~/plugins/datatables-bs4/js/dataTables.bootstrap4.min.js"></script>
    <script>
        $(document).ready(function () {
            $("#tblDepartments").DataTable({
                "responsive": true, "autoWidth": false,
                "language": { "url": "https://cdn.datatables.net/plug-ins/1.10.25/i18n/Turkish.json" },
                "order": [[1, "asc"]],
                "columnDefs": [
                    { "targets": [0], "visible": false },
                    { "targets": [2], "orderable": false, "searchable": false }
                ]
            });
            @if (Model.ErrorInfo != null)
            {
                <text>$('#deleteErrorModal').modal('show');</text>
            }
        });
    </script>
}