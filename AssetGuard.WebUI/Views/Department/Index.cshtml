@using AssetGuard.Entity
@model AssetGuard.WebUI.Models.DepartmentListViewModel

@{
    ViewData["Title"] = "Departman Yönetimi";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="card">
    <div class="card-header">
        <h3 class="card-title">Tüm Departmanlar</h3>
        <div class="card-tools">
            <a href="/Department/Create" class="btn btn-primary btn-sm">
                <i class="fas fa-plus"></i> Yeni Departman Ekle
            </a>
        </div>
    </div>

    <div class="card-body p-0">
        <table class="table table-striped projects table-hover">
            <thead>
                <tr>
                    <th style="width: 10%">ID</th>
                    <th style="width: 70%">Departman Adı</th>
                    <th style="width: 20%">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Departments)
                {
                    <tr>
                        <td>@item.Id</td>
                        <td>
                            <strong>@item.Name</strong>
                        </td>
                        <td class="project-actions text-right">
                            <a class="btn btn-info btn-sm" href="/Department/Edit/@item.Id">
                                <i class="fas fa-pencil-alt"></i> Düzenle
                            </a>
                            <a class="btn btn-danger btn-sm" href="/Department/Delete/@item.Id" onclick="return confirm('Bu departmanı silmek istediğinize emin misiniz?');">
                                <i class="fas fa-trash"></i> Sil
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- ================================================= -->
<!-- DEPARTMAN HATA MODALI (Sadece ErrorInfo doluysa oluşur) -->
<!-- ================================================= -->
@if (Model.ErrorInfo != null)
{
    <div class="modal fade" id="deleteErrorModal" tabindex="-1" role="dialog" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content bg-danger">
                <div class="modal-header">
                    <h4 class="modal-title">
                        <i class="fas fa-exclamation-triangle mr-2"></i> @Model.ErrorInfo.EntityName Silinemedi!
                    </h4>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body" style="background-color: white; color: black;">
                    <p class="lead text-danger font-weight-bold">@Model.ErrorInfo.ErrorMessage</p>
                    <p>Silme işlemini yapabilmek için önce aşağıdaki personellerin departmanını değiştirmeli veya kayıtlarını silmelisiniz:</p>

                    <div class="table-responsive" style="max-height: 300px; overflow-y: auto;">
                        <table class="table table-sm table-bordered table-striped">
                            <thead class="thead-light">
                                <tr>
                                    <th>Bağlı Personeller</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.ErrorInfo.RelatedItems)
                                {
                                    <tr>
                                        <td><i class="fas fa-user text-muted mr-2"></i> @item</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="modal-footer justify-content-between" style="background-color: #f8f9fa; color: black;">
                    <button type="button" class="btn btn-outline-danger" data-dismiss="modal">Kapat</button>
                    <a href="/Department/Index" class="btn btn-danger">Anladım</a>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        $(document).ready(function () {
            // Eğer sunucudan ErrorInfo nesnesi dolu geldiyse, modalı otomatik tetikle
            @if (Model.ErrorInfo != null)
            {
                    <text>
                        $('#deleteErrorModal').modal('show');
                    </text>
            }
        });
    </script>
}