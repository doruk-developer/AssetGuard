@using AssetGuard.WebUI.Models
@model DepartmentListViewModel
@{
    ViewData["Title"] = "Departman Yönetimi";
    Layout = "~/Views/Shared/_Layout.cshtml";

    // Rol Kontrolü (Tek merkezden yönetmek için)
    bool isAdmin = User.IsInRole("Admin");
}

<style>
    /* 1. DataTables Oklarını Gizle (Daha modern bir görünüm için) */
    table.dataTable thead .sorting:before, table.dataTable thead .sorting:after {
        display: none !important;
    }

    /* 2. Başlık Stilleri */
    #tblDepartments thead th:not(.static-header) {
        cursor: pointer;
        transition: 0.2s;
        padding: 12px 8px !important;
        text-transform: uppercase;
        font-size: 0.85rem;
    }

        #tblDepartments thead th:not(.static-header):hover {
            background-color: #f4f6f9 !important;
            color: #007bff;
        }

    /* 3. Statik Başlıklar */
    .static-header {
        cursor: default !important;
        pointer-events: none;
        color: #999 !important;
    }
</style>

<div class="card shadow-none border-0">
    <div class="card-header border-0">
        <h3 class="card-title">Sistem Departmanları</h3>
        <div class="card-tools">
            @if (isAdmin)
            {
                <a href="/Department/Create" class="btn btn-primary btn-sm">
                    <i class="fas fa-plus mr-1"></i> Yeni Departman Ekle
                </a>
            }
            @* User girişinde burası tertemiz kalacak *@
        </div>
    </div>

    <div class="card-body p-0">
        <!-- Tabloyu tam genişliğe yaymak için width:100% zorlaması yapıldı -->
        <table id="tblDepartments" class="table table-striped projects table-hover m-0" style="width:100% !important;">
            <thead>
                <tr>
                    <th style="display:none;">ID</th>
                    @if (isAdmin)
                    {
                        <th style="width: 80%">DEPARTMAN ADI</th>
                        <th class="static-header text-right" style="width: 20%">İşlemler</th>
                    }
                    else
                    {
                        <th style="width: 100%">DEPARTMAN ADI</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Departments)
                {
                    <tr>
                        <td style="display:none;">@item.Id</td>
                        <td style="vertical-align: middle;">
                            <strong>@item.Name</strong>
                        </td>

                        @if (isAdmin)
                        {
                            <td class="text-right project-actions" style="vertical-align: middle;">
                                <a href="/Department/Edit/@item.Id" class="btn btn-info btn-sm">
                                    <i class="fas fa-pencil-alt"></i> Düzenle
                                </a>
                                <a href="/Department/Delete/@item.Id" class="btn btn-danger btn-sm" onclick="return confirm('Silinsin mi?')">
                                    <i class="fas fa-trash"></i> Sil
                                </a>
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- HATA MODALI -->
@if (Model.ErrorInfo != null)
{
    <div class="modal fade" id="deleteErrorModal" tabindex="-1" role="dialog" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content bg-danger">
                <div class="modal-header">
                    <h4 class="modal-title"><i class="fas fa-exclamation-triangle mr-2"></i> @Model.ErrorInfo.EntityName Silinemedi!</h4>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                </div>
                <div class="modal-body" style="background-color: white; color: black;">
                    <p class="lead text-danger font-weight-bold">@Model.ErrorInfo.ErrorMessage</p>
                    <div class="table-responsive" style="max-height: 250px;">
                        <table class="table table-sm table-bordered table-striped">
                            <thead class="thead-light"><tr><th>İlişkili Personeller</th></tr></thead>
                            <tbody>
                                @foreach (var relate in Model.ErrorInfo.RelatedItems)
                                {
                                    <tr><td><i class="fas fa-user text-muted mr-2"></i> @relate</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="modal-footer"><button type="button" class="btn btn-secondary" data-dismiss="modal">Kapat</button></div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script src="~/plugins/datatables/jquery.dataTables.min.js"></script>
    <script src="~/plugins/datatables-bs4/js/dataTables.bootstrap4.min.js"></script>

    <script>
        $(document).ready(function () {
            // 1. VS UYARILARINI ENGELLEMEK İÇİN GÜVENLİ PARSE
            var isAdminRole = JSON.parse('@(isAdmin ? "true" : "false")');
            var hasError = JSON.parse('@(Model.ErrorInfo != null ? "true" : "false")');

            // 2. Dinamik Sütun Ayarı
            var colDefinitions = [{ "targets": [0], "visible": false }];
            if (isAdminRole) {
                colDefinitions.push({ "targets": [2], "orderable": false });
            }

            // 3. DataTable Başlatma
            $("#tblDepartments").DataTable({
                "responsive": true,
                "lengthChange": true,
                "autoWidth": false,
                "language": { "url": "https://cdn.datatables.net/plug-ins/1.10.25/i18n/Turkish.json" },
                "columnDefs": colDefinitions
            });

            // 4. Modal Tetikleme
            if (hasError) {
                $('#deleteErrorModal').modal('show');
            }
        });
    </script>
}