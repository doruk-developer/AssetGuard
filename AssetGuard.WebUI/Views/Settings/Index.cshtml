@{
    ViewData["Title"] = "Sistem ve Panel Ayarları";
}

<div class="row">
    <div class="col-md-12">
        <div class="card card-primary card-outline card-tabs">
            <div class="card-header p-0 pt-1 border-bottom-0">
                <ul class="nav nav-tabs" id="settingsTab" role="tablist">
                    <li class="nav-item">
                        <a class="nav-link active" id="view-tab" data-toggle="pill" href="#tab-view" role="tab">Görünüm Ayarları</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" id="dashboard-tab" data-toggle="pill" href="#tab-dashboard" role="tab">Dashboard Tercihleri</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" id="security-tab" data-toggle="pill" href="#tab-security" role="tab">Profil & Güvenlik</a>
                    </li>
                </ul>
            </div>
            <div class="card-body">
                <div class="tab-content" id="settingsTabContent">

                    <!-- 1. SEKME: GÖRÜNÜM -->
                    <div class="tab-pane fade show active" id="tab-view" role="tabpanel">
                        <div class="form-group">
                            <label>Sidebar Vurgu Rengi</label>
                            <select class="form-control col-md-4" id="sidebarColorSelector">
                                <option value="default">Varsayılan (Koyu Gri)</option> <!-- Bunu ekle -->
                                <option value="primary">Mavi</option>
                                <option value="warning">Sarı</option>
                                <option value="danger">Kırmızı</option>
                                <option value="success">Yeşil</option>
                                <option value="indigo">İndigo</option>
                                <option value="navy">Navy</option>
                                <option value="purple">Mor</option>
                                <option value="teal">Turkuaz</option>
                                <option value="white">Beyaz (Light)</option>
                            </select>
                        </div>
                        <hr />
                        <div class="form-group">
                            <label>Tema Modu</label>
                            <div class="custom-control custom-switch">
                                <input type="checkbox" class="custom-control-input" id="darkModeSwitch">
                                <label class="custom-control-label" for="darkModeSwitch">Gece Modu (Dark Mode)</label>
                            </div>
                        </div>
                    </div>

                    <!-- 2. SEKME: DASHBOARD (Şimdilik Görsel) -->
                    <div class="tab-pane fade" id="tab-dashboard" role="tabpanel">
                        <div class="row">
                            <div class="col-md-6">
                                <h5>Grafik Tercihleri</h5>
                                <!--Burası seçilen grafiğin kaydını(hatırlamasını) yapıyor-->
                                <div class="form-group">
                                    <div class="custom-control custom-radio">
                                        <!-- VALUE EKLENDİ: doughnut -->
                                        <input class="custom-control-input" type="radio" id="chart1" name="chartPref" value="doughnut" checked>
                                        <label for="chart1" class="custom-control-label">Daire (Donut) Chart</label>
                                    </div>
                                    <div class="custom-control custom-radio">
                                        <!-- VALUE EKLENDİ: bar -->
                                        <input class="custom-control-input" type="radio" id="chart2" name="chartPref" value="bar">
                                        <label for="chart2" class="custom-control-label">Çubuk (Bar) Chart</label>
                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>

                    <!-- 3. SEKME: GÜVENLİK (Şimdilik Görsel) -->
                    <div class="tab-pane fade" id="tab-security" role="tabpanel">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Mevcut Şifre</label>
                                <input type="password" class="form-control" placeholder="******">
                            </div>
                            <div class="form-group">
                                <label>Yeni Şifre</label>
                                <input type="password" class="form-control">
                            </div>
                        </div>
                    </div>

                </div>
            </div>
            <div class="card-footer">
                <button type="button" class="btn btn-success float-right" onclick="saveSettings()">Tüm Ayarları Kaydet</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Renk Kodları Sözlüğü (Layout ile Aynı)
        var colorMap = {
            'primary': '#007bff',
            'secondary': '#6c757d',
            'success': '#28a745',
            'danger': '#dc3545',
            'warning': '#ffc107',
            'info': '#17a2b8',
            'dark': '#343a40',
            'indigo': '#6610f2',
            'navy': '#001f3f',
            'purple': '#6f42c1',
            'teal': '#20c997',
            'white': '#ffffff'
        };

        $(document).ready(function () {
            loadSettings();

            // Renk Seçimi Değişince (Canlı Önizleme)
            $('#sidebarColorSelector').change(function () {
                var colorKey = $(this).val();
                changeSidebarStyle(colorKey);
            });

            // Dark Mode Değişince
            $('#darkModeSwitch').change(function () {
                var isDarkMode = $(this).is(':checked');
                var body = $('body');
                var header = $('.main-header');

                if (isDarkMode) {
                    body.addClass('dark-mode');
                    header.removeClass('navbar-white navbar-light').addClass('navbar-dark');
                } else {
                    body.removeClass('dark-mode');
                    header.removeClass('navbar-dark').addClass('navbar-white navbar-light');
                }
            });
        });

        // Stili Doğrudan Uygulayan Fonksiyon
        function changeSidebarStyle(colorKey) {
            var sidebar = $('.main-sidebar');
            var brandLink = $('.brand-link');

            if (colorKey && colorKey !== 'default') {
                var hexColor = colorMap[colorKey];
                if (hexColor) {
                    // CSS Class yerine direkt Style basıyoruz (Garantili Yöntem)
                    sidebar.attr('style', 'background-color: ' + hexColor + ' !important');
                    brandLink.attr('style', 'background-color: ' + hexColor + ' !important');

                    // Açık renkler için metin rengi ayarı
                    if (['white', 'warning', 'lime', 'teal'].includes(colorKey)) {
                         sidebar.addClass('sidebar-light-primary').removeClass('sidebar-dark-primary');
                    } else {
                         sidebar.addClass('sidebar-dark-primary').removeClass('sidebar-light-primary');
                    }
                }
            } else {
                // Varsayılan seçildiyse stili temizle (Orjinale dön)
                sidebar.removeAttr('style');
                brandLink.removeAttr('style');
                sidebar.addClass('sidebar-dark-primary').removeClass('sidebar-light-primary');
            }
        }

        function saveSettings() {
            var selectedColor = $('#sidebarColorSelector').val();
            var isDarkMode = $('#darkModeSwitch').is(':checked');
            var selectedChartType = $('input[name="chartPref"]:checked').val();

            localStorage.setItem('assetGuard_sidebarColor', selectedColor);
            localStorage.setItem('assetGuard_darkMode', isDarkMode);
            localStorage.setItem('assetGuard_chartType', selectedChartType);

            alert('Ayarlar kaydedildi ve uygulandı!');
        }

        function loadSettings() {
            var savedColor = localStorage.getItem('assetGuard_sidebarColor');
            var savedDarkMode = localStorage.getItem('assetGuard_darkMode');
            var savedChartType = localStorage.getItem('assetGuard_chartType');

            if (savedColor) {
                $('#sidebarColorSelector').val(savedColor);
                // Sayfa açılır açılmaz rengi uygula
                changeSidebarStyle(savedColor);
            }

            if (savedDarkMode === 'true') {
                $('#darkModeSwitch').prop('checked', true);
            }

            if (savedChartType) {
                $('input[name="chartPref"][value="' + savedChartType + '"]').prop('checked', true);
            }
        }
    </script>
}
