@using System.IO
@using System.Text.Json
@using AssetGuard.WebUI.Models
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment Env
@model AssetGuard.WebUI.Models.ChangePasswordViewModel

@{
    ViewData["Title"] = "Sistem ve Panel Ayarları";

    // 1. Sekme Durumunu Belirle (Controller'dan gelen bilgiye göre)
    string activeTab = Model?.ActiveTab ?? "view";

    // 2. Mevcut Ayarları Dosyadan Oku
    var currentSettings = new UserThemeSettings();
    try
    {
        if (User.Identity != null && User.Identity.IsAuthenticated)
        {
            var userName = User.Identity.Name;
            string filePath = System.IO.Path.Combine(Env.ContentRootPath, "ThemeData", $"{userName}_settings.json");

            if (System.IO.File.Exists(filePath))
            {
                string jsonContent = System.IO.File.ReadAllText(filePath);
                currentSettings = JsonSerializer.Deserialize<UserThemeSettings>(jsonContent) ?? new UserThemeSettings();
            }
        }
    }
    catch { }

    var jsonSettingsInit = JsonSerializer.Serialize(currentSettings);
}

<div class="row">
    <div class="col-md-12">

        <!-- BÜYÜK ALERT KUTULARI BURADAN SİLİNDİ. SADECE TOASTR ÇALIŞACAK. -->

        <div class="card card-primary card-outline card-tabs">
            <div class="card-header p-0 pt-1 border-bottom-0">
                <ul class="nav nav-tabs" id="settingsTab" role="tablist">
                    <li class="nav-item">
                        <a class="nav-link @(activeTab == "view" ? "active" : "")"
                           id="view-tab" data-toggle="pill" href="#tab-view" role="tab">Görünüm</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(activeTab == "dashboard" ? "active" : "")"
                           id="dashboard-tab" data-toggle="pill" href="#tab-dashboard" role="tab">Dashboard</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(activeTab == "security" ? "active" : "")"
                           id="security-tab" data-toggle="pill" href="#tab-security" role="tab">Güvenlik</a>
                    </li>
                </ul>
            </div>
            <div class="card-body">
                <div class="tab-content">

                    <!-- 1. GÖRÜNÜM AYARLARI -->
                    <div class="tab-pane fade @(activeTab == "view" ? "show active" : "")" id="tab-view" role="tabpanel">
                        <div class="form-group">
                            <label>Sidebar Rengi (Anlık Önizleme)</label>
                            <select class="form-control col-md-4" id="sidebarColorSelector">
                                <option value="default">Varsayılan (Koyu Gri)</option>
                                <option value="primary">Mavi</option>
                                <option value="warning">Sarı</option>
                                <option value="danger">Kırmızı</option>
                                <option value="success">Yeşil</option>
                                <option value="indigo">İndigo</option>
                                <option value="navy">Lacivert</option>
                                <option value="purple">Mor</option>
                                <option value="teal">Turkuaz</option>
                                <option value="white">Beyaz</option>
                            </select>
                        </div>
                        <hr />
                        <div class="form-group">
                            <div class="custom-control custom-switch">
                                <input type="checkbox" class="custom-control-input" id="darkModeSwitch">
                                <label class="custom-control-label" for="darkModeSwitch">Gece Modu (Dark Mode)</label>
                            </div>
                        </div>
                        <button type="button" class="btn btn-success" onclick="saveToDisk()">
                            <i class="fas fa-save mr-1"></i> Ayarları Kaydet
                        </button>
                    </div>

                    <!-- 2. DASHBOARD -->
                    <div class="tab-pane fade @(activeTab == "dashboard" ? "show active" : "")" id="tab-dashboard" role="tabpanel">
                        <div class="form-group">
                            <label>Grafik Tipi</label><br />
                            <div class="custom-control custom-radio d-inline mr-3">
                                <input class="custom-control-input" type="radio" id="chart1" name="chartPref" value="doughnut">
                                <label for="chart1" class="custom-control-label">Daire</label>
                            </div>
                            <div class="custom-control custom-radio d-inline">
                                <input class="custom-control-input" type="radio" id="chart2" name="chartPref" value="bar">
                                <label for="chart2" class="custom-control-label">Çubuk</label>
                            </div>
                        </div>
                        <button type="button" class="btn btn-success" onclick="saveToDisk()">Kaydet</button>
                    </div>

                    <!-- 3. GÜVENLİK -->
                    <div class="tab-pane fade @(activeTab == "security" ? "show active" : "")" id="tab-security" role="tabpanel">
                        <form asp-action="ChangePassword" method="post">
                            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                            <div class="form-group">
                                <label>Mevcut Şifre</label>
                                <input asp-for="CurrentPassword" type="password" class="form-control" required />
                                <span asp-validation-for="CurrentPassword" class="text-danger"></span>
                            </div>
                            <div class="form-group">
                                <label>Yeni Şifre</label>
                                <input asp-for="NewPassword" type="password" class="form-control" required />
                                <span asp-validation-for="NewPassword" class="text-danger"></span>
                            </div>
                            <div class="form-group">
                                <label>Tekrar</label>
                                <input asp-for="ConfirmPassword" type="password" class="form-control" required />
                                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                            </div>
                            <button type="submit" class="btn btn-primary">Değiştir</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var dbSettings = JSON.parse('@Html.Raw(jsonSettingsInit)');

        var colorMap = {
            'primary': '#007bff', 'secondary': '#6c757d', 'success': '#28a745',
            'danger': '#dc3545', 'warning': '#ffc107', 'info': '#17a2b8',
            'dark': '#343a40', 'indigo': '#6610f2', 'navy': '#001f3f',
            'purple': '#6f42c1', 'teal': '#20c997', 'white': '#ffffff'
        };

        $(document).ready(function () {
            // Ayarları Doldur
            if (dbSettings.SidebarColor) $('#sidebarColorSelector').val(dbSettings.SidebarColor);
            if (dbSettings.IsDarkMode) $('#darkModeSwitch').prop('checked', true);
            if (dbSettings.ChartType) $('input[name="chartPref"][value="' + dbSettings.ChartType + '"]').prop('checked', true);

            // Sidebar Rengi Değişimi
            $('#sidebarColorSelector').change(function() {
                var colorKey = $(this).val();
                var sidebar = $('.main-sidebar');
                var brand = $('.brand-link');

                if (colorKey !== 'default' && colorMap[colorKey]) {
                    var styleAttr = 'background-color: ' + colorMap[colorKey] + ' !important';
                    sidebar.attr('style', styleAttr);
                    brand.attr('style', styleAttr);

                    if (['white', 'warning', 'teal', 'light'].includes(colorKey)) {
                         sidebar.removeClass('sidebar-dark-primary').addClass('sidebar-light-primary');
                    } else {
                         sidebar.removeClass('sidebar-light-primary').addClass('sidebar-dark-primary');
                    }
                } else {
                    sidebar.removeAttr('style');
                    brand.removeAttr('style');
                    sidebar.removeClass('sidebar-light-primary').addClass('sidebar-dark-primary');
                }
            });

            // Dark Mode Değişimi
            $('#darkModeSwitch').change(function() {
                var isChecked = $(this).is(':checked');
                var body = $('body');
                var navbar = $('.main-header');

                if (isChecked) {
                    body.addClass('dark-mode');
                    navbar.removeClass('navbar-white navbar-light').addClass('navbar-dark');
                } else {
                    body.removeClass('dark-mode');
                    navbar.removeClass('navbar-dark').addClass('navbar-white navbar-light');
                }
            });
        });

        function saveToDisk() {
            var newSettings = {
                sidebarColor: $('#sidebarColorSelector').val(),
                isDarkMode: $('#darkModeSwitch').is(':checked'),
                chartType: $('input[name="chartPref"]:checked').val()
            };

            $.ajax({
                url: '/Settings/SaveThemeSettings',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(newSettings),
                success: function (response) {
                    if (response.success) {
                        toastr.success('Ayarlar başarıyla kaydedildi!');
                    } else {
                        toastr.error('Hata: ' + response.message);
                    }
                },
                error: function () {
                    toastr.error('Sunucu iletişim hatası.');
                }
            });
        }
    </script>
}