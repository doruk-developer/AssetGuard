@model AssetGuard.WebUI.Models.ThemeViewModel
@{
    ViewData["Title"] = "Görünüm Ayarları";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row">
    <div class="col-md-6">
        <!-- Ayar Kartı -->
        <div class="card card-primary card-outline">
            <div class="card-header">
                <h3 class="card-title"><i class="fas fa-paint-brush mr-2"></i> Tema ve Renk Tercihleri</h3>
            </div>

            <form asp-action="SaveTheme" method="post">
                <div class="card-body">
                    
                    <!-- 1. Menü Rengi Seçimi -->
                    <div class="form-group">
                        <label>Sol Menü Vurgu Rengi</label>
                        <select asp-for="SidebarColor" class="form-control">
                            <option value="primary">Mavi (Varsayılan)</option>
                            <option value="success">Yeşil</option>
                            <option value="warning">Sarı</option>
                            <option value="danger">Kırmızı</option>
                            <option value="info">Açık Mavi</option>
                            <option value="indigo">İndigo (Mor)</option>
                            <option value="gray-dark">Koyu Gri</option>
                            <option value="pink">Pembe</option>
                        </select>
                    </div>

                    <!-- 2. Dark Mode Anahtarı -->
                    <div class="form-group mt-4">
                        <div class="custom-control custom-switch">
                            <input type="checkbox" class="custom-control-input" asp-for="IsDarkMode" id="darkModeSwitch">
                            <label class="custom-control-label" for="darkModeSwitch">Gece Modu (Dark Mode)</label>
                        </div>
                    </div>
                </div>

                <div class="card-footer text-right">
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save mr-1"></i> Ayarları Kaydet
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>